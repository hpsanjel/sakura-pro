// Student Journey To-Do List Models
model TodoCategory {
  id            String    @id @default(cuid())
  consultancyId String
  name          String
  description   String?
  color         String    @default("#3B82F6")
  icon          String?
  order         Int       @default(0)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  templates     TodoTemplate[]
  todos         StudentTodo[]
  consultancy   Consultancy @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  
  @@map("todo_categories")
}

model TodoTemplate {
  id              String              @id @default(cuid())
  consultancyId   String
  categoryId      String
  title           String
  description     String?
  priority        TodoPriority        @default(MEDIUM)
  estimatedDays  Int?
  isRequired      Boolean             @default(true)
  dependencies    String[]            // Array of template IDs this depends on
  checklistItems  String[]            // Sub-tasks for this todo
  helpfulLinks    String[]            // URLs to helpful resources
  targetStage     StudentJourneyStage
  isActive        Boolean             @default(true)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  category        TodoCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  todos           StudentTodo[]
  consultancy     Consultancy         @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  
  @@map("todo_templates")
}

model StudentTodo {
  id              String              @id @default(cuid())
  studentId       String
  consultancyId   String
  templateId      String?
  categoryId      String
  title           String
  description     String?
  priority        TodoPriority        @default(MEDIUM)
  status          TodoStatus          @default(PENDING)
  dueDate         DateTime?
  assignedDate    DateTime            @default(now())
  completedDate   DateTime?
  assignedBy      String?             // User ID who assigned this
  completedBy     String?             // User ID who completed this
  notes           String?             // Student notes
  counselorNotes  String?             // Counselor notes
  checklistItems  TodoChecklistItem[]
  attachments     String[]            // File URLs
  helpfulLinks    String[]            // URLs to helpful resources
  estimatedDays   Int?
  actualDays      Int?                // Days taken to complete
  isOverdue       Boolean             @default(false)
  reminderSent    Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  student         Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  template        TodoTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  category        TodoCategory        @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  consultancy     Consultancy         @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  
  @@map("student_todos")
}

model TodoChecklistItem {
  id          String      @id @default(cuid())
  todoId      String
  title       String
  isCompleted Boolean     @default(false)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  
  todo        StudentTodo @relation(fields: [todoId], references: [id], onDelete: Cascade)
  
  @@map("todo_checklist_items")
}

enum TodoPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
  BLOCKED
}

enum StudentJourneyStage {
  INITIAL_ENQUIRY
  DOCUMENTATION
  APPLICATION_SUBMITTED
  APPLICATION_PROCESSING
  OFFER_RECEIVED
  ACCEPTANCE_CONFIRMED
  VISA_APPLICATION
  VISA_PROCESSING
  VISA_APPROVED
  PRE_DEPARTURE
  FLIGHT_BOOKING
  ACCOMMODATION_SETUP
  PACKING_PREPARATION
  DEPARTURE
  POST_ARRIVAL
}

enum MessageStatus {
  SENT
  READ
  DELETED
}

// Automated Workflow & Reminder System Models
model ReminderTemplate {
  id              String              @id @default(cuid())
  consultancyId   String
  name            String
  description     String?
  triggerEvent    TriggerEvent
  triggerCondition String?            // JSON conditions for when to trigger
  timingType      TimingType          @default(IMMEDIATE)
  timingValue     Int?                // Days/hours before/after event
  messageTemplate String              // Email/SMS template with variables
  inAppMessage   String?             // In-app notification message
  recipientType   RecipientType       @default(STUDENT)
  isActive        Boolean             @default(true)
  priority        NotificationPriority @default(MEDIUM)
  channels        NotificationChannel[] @default([IN_APP])
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  consultancy     Consultancy         @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  executions      WorkflowExecution[]
  
  @@map("reminder_templates")
}

model Workflow {
  id              String              @id @default(cuid())
  consultancyId   String
  name            String
  description     String?
  triggerEvent    TriggerEvent
  triggerCondition String?            // JSON conditions
  isActive        Boolean             @default(true)
  priority        WorkflowPriority    @default(MEDIUM)
  createdBy       String              // User ID
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  consultancy     Consultancy         @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  creator         User                @relation(fields: [createdBy], references: [id])
  executions      WorkflowExecution[]
  
  @@map("workflows")
}

model WorkflowExecution {
  id              String              @id @default(cuid())
  workflowId      String?
  studentId       String?
  userId          String?
  consultancyId   String
  templateId      String?             // Reminder template ID if triggered by template
  triggerData     Json?               // Event data that triggered this
  status          ExecutionStatus      @default(PENDING)
  scheduledAt     DateTime            // When scheduled to execute
  executedAt      DateTime?
  completedAt     DateTime?
  result          Json?               // Execution result
  errorMessage    String?
  retryCount      Int                 @default(0)
  maxRetries      Int                 @default(3)
  nextRetryAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  workflow        Workflow?            @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  student         Student?            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  user            User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  template        ReminderTemplate?   @relation(fields: [templateId], references: [id])
  notifications    Notification[]
  consultancy     Consultancy         @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  
  @@map("workflow_executions")
}

model Notification {
  id              String              @id @default(cuid())
  executionId     String?             // Workflow execution ID
  recipientId     String              // User ID who receives this
  consultancyId   String
  type            NotificationType
  title           String
  message         String
  data            Json?               // Additional data
  channels        NotificationChannel[] @default([IN_APP])
  status          NotificationStatus   @default(PENDING)
  scheduledAt     DateTime            @default(now())
  sentAt          DateTime?
  readAt          DateTime?
  isRead          Boolean             @default(false)
  priority        NotificationPriority @default(MEDIUM)
  expiresAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  execution       WorkflowExecution?  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  recipient       User                @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  consultancy     Consultancy         @relation(fields: [consultancyId], references: [id], onDelete: Cascade)
  
  @@map("notifications")
}

